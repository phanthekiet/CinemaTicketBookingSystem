<Application x:Class="CinemaTicketBookingSystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/CustomerHomeWindow.xaml">
    <Application.Resources>
        <!-- 1. Bộ font Be Vietnam Pro nhúng trực tiếp kèm fallback Segoe UI -->
        <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Be Vietnam Pro, Segoe UI, sans-serif</FontFamily>

        <!-- Font Thương Hiệu Điện Ảnh Đặc Biệt (Bebas Neue Display Font) -->
        <FontFamily x:Key="BrandFont">pack://application:,,,/Assets/Fonts/#Bebas Neue, Impact, Montserrat, Arial Black, sans-serif</FontFamily>

        <!-- 2. Bảng màu Galaxy Cosmic Cinema Palette (Đẳng cấp điện ảnh vũ trụ) -->
        <SolidColorBrush x:Key="BgDark" Color="#070A12"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#0D1220"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131B2E"/>
        <SolidColorBrush x:Key="SurfaceCardHover" Color="#1A243E"/>
        <SolidColorBrush x:Key="BorderQuiet" Color="#1E2B47"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2E4069"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E50914"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#F41824"/>
        <SolidColorBrush x:Key="AccentGold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Theme Tokens alias for backward compatibility -->
        <SolidColorBrush x:Key="ThemeBgDark" Color="#070A12"/>
        <SolidColorBrush x:Key="ThemeSurfaceDark" Color="#0D1220"/>
        <SolidColorBrush x:Key="ThemeSurfaceCard" Color="#131B2E"/>
        <SolidColorBrush x:Key="ThemeBorderQuiet" Color="#1E2B47"/>
        <SolidColorBrush x:Key="ThemeBorderLight" Color="#2E4069"/>
        <SolidColorBrush x:Key="ThemeAccentRed" Color="#E50914"/>
        <SolidColorBrush x:Key="ThemeAccentRedHover" Color="#F41824"/>
        <SolidColorBrush x:Key="ThemeAccentGold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ThemeTextMuted" Color="#64748B"/>

        <!-- 3. Cosmic Gradient Brushes -->
        <LinearGradientBrush x:Key="GalaxyRedGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E50914" Offset="0.0"/>
            <GradientStop Color="#991B1B" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GalaxyScreenBeamBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6606B6D4" Offset="0.0"/>
            <GradientStop Color="#1A0D1220" Offset="0.7"/>
            <GradientStop Color="#00070A12" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 4. Base styles -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <Style TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <!-- 5. Custom Slim Dark ScrollBar (Hỗ trợ cả thanh cuộn Dọc và thanh cuộn Ngang) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#0A0D14"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="GridRoot" Width="8" Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Background="#2E4069" BorderThickness="0">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GridRoot" Property="Background" Value="#111827"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="GridRoot" Height="10" Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Background="#2E4069" BorderThickness="0">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border CornerRadius="5" Background="{TemplateBinding Background}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GridRoot" Property="Background" Value="#111827"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 6. TabControl & TabItem Galaxy Pill Style -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#0D1220"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="tabBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="#1E2B47" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" 
                                              ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#131B2E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#251214"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#E50914"/>
                                <Setter Property="Foreground" Value="#E50914"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 7. ComboBox Dark Cosmic Style -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Border x:Name="templateRoot" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="8">
                <Border Width="28" HorizontalAlignment="Right">
                    <Path x:Name="arrow" 
                          Data="M 0 0 L 4 4 L 8 0 Z" 
                          Fill="#94A3B8" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#06B6D4"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#06B6D4"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#06B6D4"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#06B6D4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#131B2E"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#1E2B47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Template="{StaticResource DarkComboBoxToggleButton}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,0,32,0" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                                        Background="#0D1220" 
                                        BorderBrush="#1E2B47" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Margin="0,4,0,0" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="56"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleButton" Property="BorderBrush" Value="#06B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1A243E"/>
                                <Setter Property="Foreground" Value="#06B6D4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#06B6D4"/>
                                <Setter Property="Foreground" Value="#070A12"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 8. Premium Dark Cosmic DatePicker & Calendar Style -->
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="#131B2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E2B47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Border x:Name="borderRoot" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <Grid x:Name="PART_Root" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <DatePickerTextBox x:Name="PART_TextBox" 
                                                   Grid.Column="0" 
                                                   Focusable="{TemplateBinding Focusable}" 
                                                   HorizontalContentAlignment="Stretch" 
                                                   VerticalContentAlignment="Center" 
                                                   Foreground="White" 
                                                   FontSize="13" 
                                                   Background="Transparent" 
                                                   BorderThickness="0"/>
                                
                                <Button x:Name="PART_Button" 
                                        Grid.Column="1" 
                                        Width="38" 
                                        Height="38" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Cursor="Hand" 
                                        Margin="0,0,2,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6" Padding="6">
                                                <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#1A243E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                
                                <Popup x:Name="PART_Popup" 
                                       AllowsTransparency="True" 
                                       Placement="Bottom" 
                                       PlacementTarget="{Binding ElementName=borderRoot}" 
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderRoot" Property="BorderBrush" Value="#06B6D4"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="borderRoot" Property="BorderBrush" Value="#06B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calendar Dark Cosmic Theme -->
        <Style TargetType="{x:Type Calendar}">
            <Setter Property="Background" Value="#0D1220"/>
            <Setter Property="BorderBrush" Value="#1E2B47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
    </Application.Resources>
</Application>
