<Window x:Class="CinemaTicketBookingSystem.Views.CustomerHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaTicketBookingSystem.Views"
        mc:Ignorable="d"
        Title="KPID CINEMA - Trải Nghiệm Điện Ảnh Đẳng Cấp" 
        Height="850" Width="1300"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="#F3F4F6"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Color Palette Tokens: Cosmic Galaxy Cinema -->
        <SolidColorBrush x:Key="BgDark" Color="#070A12"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#0D1220"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131B2E"/>
        <SolidColorBrush x:Key="SurfaceCardHover" Color="#1A243E"/>
        <SolidColorBrush x:Key="BorderQuiet" Color="#1E2B47"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2E4069"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E50914"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#F41824"/>
        <SolidColorBrush x:Key="AccentGold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Primary Action Button Style with Subtle Cosmic Glow -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C00711"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Ghost Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#131B2E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A243E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D1220"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Tab Button Style -->
        <Style x:Key="FilterTabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Arrow Button Style -->
        <Style x:Key="SliderArrowBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC000000"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <!-- Galaxy Deep Space Ambient Background Layer -->
        <Image Source="/Assets/galaxy_bg.jpg" Stretch="UniformToFill" Opacity="0.16" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <!-- Main Application Shell -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/> <!-- Header Navbar -->
                <RowDefinition Height="*"/>  <!-- Main Scrollable Area -->
                <RowDefinition Height="36"/> <!-- Bottom Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. TOP NAVBAR -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Brand & Logo -->
                        <ColumnDefinition Width="*"/>    <!-- Search & Filters -->
                        <ColumnDefinition Width="Auto"/> <!-- User Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Brand / Logo Area: Logo + KPID CINEMA -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="10" Background="#111319" Margin="0,0,12,0" BorderBrush="#2E4069" BorderThickness="1.5">
                            <Image x:Name="imgLogo" Source="/Assets/logo.png" Stretch="Uniform" Margin="3"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KPID" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="28" Foreground="{StaticResource AccentRed}" Margin="0,0,6,0"/>
                                <TextBlock Text="CINEMA" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="28" Foreground="White"/>
                            </StackPanel>
                            <TextBlock Text="PREMIUM ENTERTAINMENT" FontSize="10" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center Search & Filter Area -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,24,0">
                        <!-- Search Box -->
                        <Border Background="#1C202C" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40" Width="280">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" FontSize="13" TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock x:Name="txtSearchPlaceholder" Grid.Column="1" Text="Tìm tên phim, diễn viên..." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False"/>
                                <Button x:Name="btnClearSearch" Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}" Cursor="Hand" Click="BtnClearSearch_Click" Visibility="Collapsed" Padding="4"/>
                            </Grid>
                        </Border>

                        <!-- Genre Filter Dropdown -->
                        <Border Background="#1C202C" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40" Margin="12,0,0,0" Padding="8,0">
                            <ComboBox x:Name="cboGenre" Width="150" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" SelectionChanged="CboGenre_SelectionChanged">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#1C202C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- Right Navigation & User Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Refresh Button -->
                        <Button x:Name="btnRefresh" Content="🔄 Làm mới" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,10,0" Click="BtnRefresh_Click"/>

                        <!-- Admin Portal Button (Visible only to Admin) -->
                        <Button x:Name="btnAdminPortal" Content="⚙️ Quản Trị Hệ Thống" Style="{StaticResource PrimaryBtnStyle}" Margin="0,0,10,0" Visibility="Collapsed" Click="BtnAdminPortal_Click"/>

                        <!-- My Tickets Button (TASK-10) -->
                        <Button x:Name="btnMyTickets" Content="🎟️ Vé của tôi / Tra cứu" ToolTip="Xem lịch sử vé hoặc tra cứu mã QR vé vừa đặt bằng Số điện thoại" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,14,0" Click="BtnMyTickets_Click"/>

                        <!-- User Session Widget -->
                        <Border Background="#1C202C" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Padding="12,6" Height="40">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentRed}" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtUserInitial" Text="👤" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="txtUserName" Text="Khách" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="btnAuth" Content="Đăng nhập" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" Cursor="Hand" Click="BtnAuth_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN SCROLLABLE CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,40">

                    <!-- HERO CAROUSEL BANNER (3 slider images in asset) -->
                    <Border CornerRadius="14" Margin="0,0,0,32" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" Background="#0A0B0E" ClipToBounds="True">
                        <Grid Height="340">
                            <!-- Slider Image -->
                            <Image x:Name="imgSlider" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Cinema Gradient Overlay -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#E60E1015" Offset="0.0"/>
                                        <GradientStop Color="#800E1015" Offset="0.5"/>
                                        <GradientStop Color="#200E1015" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Slider Content Overlay -->
                            <Grid Margin="36,0">
                                <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                                    <Border Background="{StaticResource AccentRed}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="ĐANG CHIẾU RẠP • CÔNG NGHỆ LASER 4K" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="txtSliderTitle" Text="ĐẠI TIỆC ĐIỆN ẢNH ĐỈNH CAO" FontSize="30" FontWeight="Black" Foreground="White" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtSliderDesc" Text="Đặt vé trực tuyến nhanh chóng, chọn vị trí ngồi yêu thích và nhận ngay ưu đãi combo bắp nước độc quyền." FontSize="14" Foreground="#D1D5DB" Margin="0,0,0,22" TextWrapping="Wrap" LineHeight="20"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🍿 Đặt vé ngay" Style="{StaticResource PrimaryBtnStyle}" Padding="20,10" FontSize="14" Click="BtnBannerBook_Click" Margin="0,0,12,0"/>
                                        <Button Content="Xem tất cả phim" Style="{StaticResource SecondaryBtnStyle}" Padding="18,10" FontSize="14" Click="BtnBannerExplore_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Carousel Navigation Controls -->
                            <Button Style="{StaticResource SliderArrowBtnStyle}" Content="❮" HorizontalAlignment="Left" Margin="14,0,0,0" VerticalAlignment="Center" Click="BtnPrevSlide_Click"/>
                            <Button Style="{StaticResource SliderArrowBtnStyle}" Content="❯" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" Click="BtnNextSlide_Click"/>

                            <!-- Slide Indicator Dots -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                <Ellipse x:Name="dot1" Width="10" Height="10" Fill="{StaticResource AccentRed}" Margin="4,0" Cursor="Hand" MouseDown="Dot1_MouseDown"/>
                                <Ellipse x:Name="dot2" Width="10" Height="10" Fill="#50FFFFFF" Margin="4,0" Cursor="Hand" MouseDown="Dot2_MouseDown"/>
                                <Ellipse x:Name="dot3" Width="10" Height="10" Fill="#50FFFFFF" Margin="4,0" Cursor="Hand" MouseDown="Dot3_MouseDown"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SECTION HEADER & FILTER PILLS -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Section Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="24" Fill="{StaticResource AccentRed}" Margin="0,0,12,0" RadiusX="2" RadiusY="2"/>
                            <TextBlock Text="PHIM ĐANG CHIẾU" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Border Background="#222736" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtMovieCount" Text="0 phim" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <!-- Filter Status Pills -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btnTabAll" Content="Tất cả" Style="{StaticResource FilterTabBtnStyle}" Background="#2B3142" Foreground="White" Margin="0,0,6,0" Click="BtnTabAll_Click"/>
                            <Button x:Name="btnTabActive" Content="Đang chiếu" Style="{StaticResource FilterTabBtnStyle}" Margin="0,0,6,0" Click="BtnTabActive_Click"/>
                            <Button x:Name="btnTabUpcoming" Content="Sắp chiếu" Style="{StaticResource FilterTabBtnStyle}" Click="BtnTabUpcoming_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- MOVIE CARDS ITEMS CONTROL (Card View) -->
                    <ItemsControl x:Name="icMovies">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Single Movie Card -->
                                <Border Width="280" Margin="0,0,20,24" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                                    <Setter Property="Background" Value="{StaticResource SurfaceCardHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="370"/> <!-- Poster Area -->
                                            <RowDefinition Height="Auto"/> <!-- Movie Meta -->
                                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                        </Grid.RowDefinitions>

                                        <!-- Poster with Age Rating Badge -->
                                        <Grid Grid.Row="0" Cursor="Hand" MouseDown="CardPoster_MouseDown" Tag="{Binding MovieId}">
                                            <Image Source="{Binding PosterSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Bottom darkening for text readability -->
                                            <Border VerticalAlignment="Bottom" Height="80">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                        <GradientStop Color="#EE1C202C" Offset="0"/>
                                                        <GradientStop Color="#001C202C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Age Rating Badge (P, T13, T16, T18) -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="{Binding AgeRatingBackground}" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="{Binding AgeRating}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>

                                            <!-- Showtimes Indicator Badge -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="#CC0E1015" CornerRadius="4" Padding="7,4">
                                                <TextBlock Text="{Binding ShowtimesCountText}" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                        </Grid>

                                        <!-- Movie Meta Details -->
                                        <StackPanel Grid.Row="1" Margin="16,12,16,10">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" ToolTip="{Binding Title}" Cursor="Hand" MouseDown="CardPoster_MouseDown" Tag="{Binding MovieId}"/>
                                            
                                            <!-- Genre & Duration -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding GenreName}" Foreground="{StaticResource AccentGold}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="  •  " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{Binding DurationFormatted}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                            </StackPanel>

                                            <!-- Release Date -->
                                            <TextBlock Text="{Binding ReleaseDateFormatted}" Foreground="{StaticResource TextMuted}" FontSize="11"/>

                                            <!-- Short Description Preview -->
                                            <TextBlock Text="{Binding Description}" Foreground="#9CA3AF" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,8,0,0" LineHeight="17" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Card Footer Actions -->
                                        <Grid Grid.Row="2" Margin="16,0,16,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="ℹ️ Chi tiết" Style="{StaticResource SecondaryBtnStyle}" Padding="12,8" FontSize="12" Click="BtnDetails_Click" Tag="{Binding MovieId}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="🎟️ Đặt vé ngay" Style="{StaticResource PrimaryBtnStyle}" Padding="14,8" FontSize="12" Click="BtnBookTicket_Click" Tag="{Binding MovieId}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- EMPTY SEARCH / FILTER STATE -->
                    <Border x:Name="bdrEmptyState" Visibility="Collapsed" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="40" HorizontalAlignment="Center" Margin="0,40,0,40">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Không tìm thấy phim phù hợp" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtEmptyDetail" Text="Vui lòng thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc thể loại." FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <Button Content="Xóa bộ lọc &amp; Xem tất cả phim" Style="{StaticResource PrimaryBtnStyle}" HorizontalAlignment="Center" Click="BtnResetFilter_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. BOTTOM STATUS BAR -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,1,0,0" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="statusIndicator" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDbStatus" Text="Đã kết nối cơ sở dữ liệu rạp phim (CinemaManagementDB)" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Cinema Ticket Booking System" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. MOVIE DETAILS MODAL OVERLAY (TASK-10) -->
        <Grid x:Name="gridModalOverlay" Visibility="Collapsed">
            <!-- Semi-transparent backdrop -->
            <Border Background="#CC000000" MouseDown="ModalBackdrop_MouseDown"/>

            <!-- Modal Card Container -->
            <Border Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" MaxWidth="720" MaxHeight="620" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Modal Header -->
                        <RowDefinition Height="*"/>    <!-- Modal Body -->
                        <RowDefinition Height="Auto"/> <!-- Modal Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#131620" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <TextBlock Text="THÔNG TIN CHI TIẾT BỘ PHIM" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="✕" Width="30" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondary}" FontSize="16" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="BtnCloseModal_Click"/>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Modal Poster -->
                            <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" Height="310" VerticalAlignment="Top">
                                <Image x:Name="imgModalPoster" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Modal Info -->
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock x:Name="txtModalTitle" Text="Tên Phim" FontSize="22" FontWeight="Black" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border x:Name="bdrModalAge" Background="{StaticResource AccentRed}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock x:Name="txtModalAge" Text="T16" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                    </Border>
                                    <Border Background="#2B3142" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                        <TextBlock x:Name="txtModalGenre" Text="Hành động" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentGold}"/>
                                    </Border>
                                    <Border Background="#2B3142" CornerRadius="4" Padding="8,2">
                                        <TextBlock x:Name="txtModalDuration" Text="120 phút" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Age Explanation Notice -->
                                <Border x:Name="bdrAgeNotice" Background="#281A1C" BorderBrush="#50E50914" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                    <TextBlock x:Name="txtModalAgeNotice" Text="⚠️ Phim dành cho khán giả từ 16 tuổi trở lên." FontSize="11" Foreground="#FFAAA6" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="NGÀY KHỞI CHIẾU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtModalReleaseDate" Text="30/04/2026" FontSize="13" Foreground="White" Margin="0,0,0,12"/>

                                <TextBlock Text="NỘI DUNG TÓM TẮT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtModalDesc" Text="Mô tả nội dung phim..." FontSize="13" Foreground="#D1D5DB" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"/>

                                <!-- Available Showtimes Preview in Modal -->
                                <TextBlock Text="SUẤT CHIẾU HIỆN CÓ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="icModalShowtimes">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#222736" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StartTimeFormatted}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                                    <TextBlock Text=" - " Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding RoomName}" Foreground="{StaticResource AccentGold}" FontSize="12"/>
                                                    <TextBlock Text=" (" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding PriceFormatted}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                    <TextBlock Text=")" Foreground="{StaticResource TextMuted}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="txtNoShowtimesInModal" Text="Hiện tại chưa có suất chiếu nào cho phim này." FontSize="12" Foreground="{StaticResource TextMuted}" FontStyle="Italic" Visibility="Collapsed" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#131620" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,1,0,0" Padding="20,14">
                        <Grid>
                            <Button Content="Đóng" Style="{StaticResource SecondaryBtnStyle}" HorizontalAlignment="Left" Click="BtnCloseModal_Click"/>
                            <Button x:Name="btnModalBookNow" Content="🎟️ Tiến hành đặt vé ngay" Style="{StaticResource PrimaryBtnStyle}" HorizontalAlignment="Right" Click="BtnModalBookNow_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
