<Window x:Class="CinemaTicketBookingSystem.Views.AdminFoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaTicketBookingSystem.Views"
        mc:Ignorable="d"
        Title="KPID CINEMA - Quản Lý Bắp Nước &amp; Tồn Kho" 
        Height="840" Width="1350"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="#F3F4F6"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Palette Tokens -->
        <SolidColorBrush x:Key="BgDark" Color="#070A12"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#0D1220"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131B2E"/>
        <SolidColorBrush x:Key="BorderQuiet" Color="#1E2B47"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A3B60"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E50914"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#F41824"/>
        <SolidColorBrush x:Key="AccentGold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C00711"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Tab Button Style -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Tab Button Style -->
        <Style x:Key="ActiveNavBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="Background" Value="#251214"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#161922"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#161922"/>
            <Setter Property="AlternatingRowBackground" Value="#1A1E29"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111319"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A1B20"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <!-- Galaxy Background Layer -->
        <Image Source="/Assets/galaxy_bg.jpg" Stretch="UniformToFill" Opacity="0.14" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Global Admin Header -->
                <RowDefinition Height="*"/>    <!-- Module Content -->
            </Grid.RowDefinitions>

        <!-- 1. TOP GLOBAL ADMIN HEADER -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand -->
                    <ColumnDefinition Width="*"/>    <!-- Center Navigation Links -->
                    <ColumnDefinition Width="Auto"/> <!-- Current User & Exit -->
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#111319" Margin="0,0,10,0" BorderBrush="#2E4069" BorderThickness="1.5">
                        <Image Source="/Assets/logo.png" Stretch="Uniform" Margin="3"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KPID" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="{StaticResource AccentRed}" Margin="0,0,5,0"/>
                            <TextBlock Text="CINEMA" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="HỆ THỐNG QUẢN TRỊ" FontSize="10" Foreground="{StaticResource AccentGold}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Links -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="🎬 Phim &amp; Thể loại" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToMovies_Click"/>
                    <Button Content="🏛️ Phòng &amp; Suất chiếu" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToShowtimes_Click"/>
                    <Button Content="🍿 Bắp nước" Style="{StaticResource ActiveNavBtnStyle}" Margin="4,0"/>
                    <Button Content="📊 Soát vé &amp; Thống kê" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToReports_Click"/>
                </StackPanel>

                <!-- Current User & Exit -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="txtAdminName" Text="Admin: Quản trị viên" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Text="Phân quyền: Toàn quyền quản trị" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Về Trang Khách" Style="{StaticResource GhostBtnStyle}" Margin="0,0,8,0" Click="BtnCustomerHome_Click"/>
                    <Button Content="Đăng xuất" Style="{StaticResource GhostBtnStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN MODULE CONTENT -->
        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- Left: DataGrid & Quick Search -->
                <ColumnDefinition Width="24"/>  <!-- Gap -->
                <ColumnDefinition Width="420"/> <!-- Right: CRUD Form & Stock update -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: FOOD LIST & SEARCH -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filter -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,12,0">
                            <Grid Margin="12,0">
                                <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtSearchFood" Margin="24,0,0,0" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" FontSize="13" TextChanged="TxtSearchFood_TextChanged"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Content="🔄 Tải lại" Style="{StaticResource GhostBtnStyle}" Height="40" Click="BtnReloadFood_Click"/>
                    </Grid>

                    <!-- Food DataGrid -->
                    <DataGrid x:Name="dgFoods" Grid.Row="1" SelectionChanged="DgFoods_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ MÓN" Binding="{Binding FoodId}" Width="80"/>
                            <DataGridTextColumn Header="TÊN COMBO / BẮP NƯỚC" Binding="{Binding FoodName}" Width="2*"/>
                            <DataGridTextColumn Header="GIÁ BÁN" Binding="{Binding PriceString}" Width="120"/>
                            <DataGridTemplateColumn Header="TỒN KHO" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StockBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StockString}" Foreground="{Binding StockFg}" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,4" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Stats Footer -->
                    <TextBlock x:Name="txtFoodStats" Grid.Row="2" Text="Tổng số: 0 món ăn &amp; combo" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- RIGHT: CRUD & STOCK UPDATE FORM -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="22" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN BẮP NƯỚC" FontSize="16" FontWeight="Black" Foreground="White" Margin="0,0,0,16"/>

                    <!-- Food Name -->
                    <TextBlock Text="TÊN MÓN / COMBO *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,14">
                        <TextBox x:Name="txtFoodName" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="12,0" FontSize="13"/>
                    </Border>

                    <!-- Price -->
                    <TextBlock Text="GIÁ BÁN (VND) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,14">
                        <TextBox x:Name="txtPrice" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="12,0" FontSize="13"/>
                    </Border>

                    <!-- Stock & Stock Adder Grid -->
                    <TextBlock Text="SỐ LƯỢNG TỒN KHO *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Stock input -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40">
                            <TextBox x:Name="txtStock" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="12,0" FontSize="13"/>
                        </Border>

                        <!-- Quick Add +10 -->
                        <Button Grid.Column="2" Content="+10" Style="{StaticResource GhostBtnStyle}" Height="40" Padding="10,0" Click="BtnQuickAdd10_Click"/>

                        <!-- Quick Add +50 -->
                        <Button Grid.Column="4" Content="+50" Style="{StaticResource GhostBtnStyle}" Height="40" Padding="10,0" Click="BtnQuickAdd50_Click"/>
                    </Grid>

                    <!-- Status CheckBox -->
                    <CheckBox x:Name="chkFoodStatus" Content="Đang kinh doanh (Mở bán trực tuyến)" Foreground="White" FontSize="13" IsChecked="True" Margin="0,10,0,20"/>

                    <!-- Action Buttons -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="＋ Thêm Món Mới" Style="{StaticResource PrimaryBtnStyle}" Height="42" Click="BtnAddFood_Click"/>
                        <Button Grid.Column="2" Content="💾 Lưu Cập Nhật" Style="{StaticResource GhostBtnStyle}" Height="42" Click="BtnUpdateFood_Click"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="🛑 Ngừng Bán" Style="{StaticResource GhostBtnStyle}" Height="38" Click="BtnToggleStatusFood_Click"/>
                        <Button Grid.Column="2" Content="🧹 Làm Mới Form" Style="{StaticResource GhostBtnStyle}" Height="38" Click="BtnClearFoodForm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
