<Window x:Class="CinemaTicketBookingSystem.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaTicketBookingSystem.Views"
        mc:Ignorable="d"
        Title="KPID CINEMA - Combo Bắp Nước &amp; Thanh Toán" 
        Height="800" Width="1200"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="#F3F4F6"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Palette Tokens -->
        <SolidColorBrush x:Key="BgDark" Color="#070A12"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#0D1220"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131B2E"/>
        <SolidColorBrush x:Key="BorderQuiet" Color="#1E2B47"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A3B60"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E50914"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#F41824"/>
        <SolidColorBrush x:Key="AccentGold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C00711"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <!-- Galaxy Deep Space Background -->
        <Image Source="/Assets/galaxy_bg.jpg" Stretch="UniformToFill" Opacity="0.14" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Main Body: Food + Payment & Order Summary -->
            </Grid.RowDefinitions>

        <!-- TOP BAR: Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnBackToSeats" Content="← Chọn lại ghế" Style="{StaticResource GhostBtnStyle}" Margin="0,0,18,0" Click="BtnBackToSeats_Click"/>
                    <Border Width="40" Height="40" CornerRadius="8" Background="#111319" Margin="0,0,10,0" BorderBrush="#2E4069" BorderThickness="1.5">
                        <Image Source="/Assets/logo.png" Stretch="Uniform" Margin="3"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KPID" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="{StaticResource AccentRed}" Margin="0,0,5,0"/>
                            <TextBlock Text="CINEMA" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="COMBO BẮP NƯỚC &amp; THANH TOÁN" FontSize="10" Foreground="{StaticResource AccentGold}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtCustomerName" Text="Khách hàng" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Text="Bảo mật thanh toán 256-bit SSL" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1" Margin="24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- Left: Food selection + Customer Info -->
                <ColumnDefinition Width="24"/>   <!-- Gap -->
                <ColumnDefinition Width="420"/>  <!-- Right: Order Summary & VietQR -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Food combos & Customer Info -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <!-- SECTION 1: FOOD & DRINKS -->
                    <Border Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="🍿" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="COMBO BẮP NƯỚC &amp; SNACK ĐIỆN ẢNH" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Ưu đãi giảm giá 15% khi đặt kèm vé trực tuyến" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Dynamic Food Items Container -->
                            <StackPanel x:Name="spFoodList">
                                <TextBlock Text="Đang tải danh sách bắp nước..." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: CUSTOMER INFO & PAYMENT METHOD -->
                    <Border Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="💳" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="THÔNG TIN KHÁCH HÀNG &amp; PHƯƠNG THỨC THANH TOÁN" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Vé điện tử và hóa đơn sẽ được gửi qua số điện thoại này" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Customer Name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HỌ VÀ TÊN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40">
                                        <TextBox x:Name="txtBuyerName" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" FontSize="13" Margin="12,0"/>
                                    </Border>
                                </StackPanel>

                                <!-- Customer Phone -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40">
                                        <TextBox x:Name="txtBuyerPhone" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" FontSize="13" Margin="12,0"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Payment Options -->
                            <TextBlock Text="CHỌN HÌNH THỨC THANH TOÁN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                            <StackPanel>
                                <RadioButton x:Name="rbVnPay" IsChecked="True" Foreground="White" FontSize="13" Margin="0,0,0,10" Checked="PaymentMethod_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💳 Cổng thanh toán trực tuyến VNPAY" FontWeight="Bold"/>
                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="Thẻ ATM / Visa / QR" FontSize="10" Foreground="#93C5FD" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbVietQR" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10" Checked="PaymentMethod_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ Chuyển khoản ngân hàng VietQR tự động"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbCash" Foreground="{StaticResource TextSecondary}" FontSize="13" Checked="PaymentMethod_Checked">
                                    <TextBlock Text="💵 Thanh toán trực tiếp tại quầy vé rạp"/>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: ORDER SUMMARY & VIETQR -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- Movie & Ticket Details -->
                        <RowDefinition Height="*"/>    <!-- VietQR Image or Cash info -->
                        <RowDefinition Height="Auto"/> <!-- Price Totals -->
                        <RowDefinition Height="Auto"/> <!-- Confirm Button -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="HÓA ĐƠN ĐẶT VÉ" FontSize="15" FontWeight="Black" Foreground="White" Margin="0,0,0,16"/>

                    <!-- Movie & Ticket Details Card -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="txtSummaryMovie" Text="Tên Phim" FontWeight="Bold" FontSize="15" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <TextBlock Text="Phòng chiếu:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtSummaryRoom" Text="Phòng 01" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Suất chiếu:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtSummaryTime" Text="19:30 • 28/10/2026" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Ghế đã chọn:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtSummarySeats" Text="C4, C5" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Bắp nước kèm:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtSummaryFood" Text="Không chọn" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 1. VNPay Gateway Panel -->
                    <Border x:Name="pnlVnPay" Grid.Row="2" Background="#0C1527" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,16" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Border Background="#005BAA" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="VNPAY" FontWeight="Black" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="CỔNG THANH TOÁN TRỰC TUYẾN" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="💳 🏦 📱" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <TextBlock Text="Hỗ trợ Thẻ ATM nội địa, Thẻ quốc tế Visa/Mastercard và VNPAY-QR từ mọi ứng dụng ngân hàng." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>

                            <Border Background="#070A12" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Center">
                                <TextBlock Text="🔒 Bảo mật chuẩn PCI DSS &amp; Mã hóa 256-bit" FontSize="10" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. Waiting VNPay Modal State -->
                    <Border x:Name="pnlWaitingVnPay" Grid.Row="2" Background="#160D1E" BorderBrush="#C026D3" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="ĐANG CHỜ THANH TOÁN VNPAY..." FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cổng thanh toán đã được mở trên trình duyệt của bạn. Hãy nhập thẻ test và xác thực OTP để hoàn tất." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,12"/>
                            <Button x:Name="btnCancelVnPay" Content="❌ Hủy giao dịch VNPAY" Style="{StaticResource GhostBtnStyle}" Padding="12,6" FontSize="12" Click="BtnCancelVnPay_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. VietQR Preview Panel -->
                    <Border x:Name="pnlVietQR" Grid.Row="2" Background="#0D1220" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="QUÉT MÃ VIETQR ĐỂ THANH TOÁN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <Border Width="205" Height="220" Background="White" CornerRadius="8" Padding="6" HorizontalAlignment="Center">
                                <Image x:Name="imgVietQR" Source="/Assets/vietqr_mb.png" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Ngân hàng: MB Bank • STK: 0123456789" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Chủ TK: KPID CINEMA VIETNAM" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Cash Notice Panel -->
                    <Border x:Name="pnlCash" Grid.Row="2" Background="#0D1220" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💵" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Thanh toán tại quầy vé rạp" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mã giữ vé sẽ được lưu trong hệ thống. Vui lòng nhận vé và thanh toán trước giờ chiếu 15 phút." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Price Calculations -->
                    <Border Grid.Row="3" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Text="Tiền vé xem phim:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtTotalSeatsMoney" Text="0 đ" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Tiền bắp nước:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtTotalFoodMoney" Text="0 đ" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource BorderQuiet}" Margin="0,8"/>
                            <Grid>
                                <TextBlock Text="TỔNG THANH TOÁN:" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtGrandTotal" Text="0 đ" FontSize="19" FontWeight="Black" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Confirm Button -->
                    <Button x:Name="btnConfirmPayment" Grid.Row="4" Content="XÁC NHẬN THANH TOÁN" Style="{StaticResource PrimaryBtnStyle}" Height="48" Click="BtnConfirmPayment_Click"/>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
