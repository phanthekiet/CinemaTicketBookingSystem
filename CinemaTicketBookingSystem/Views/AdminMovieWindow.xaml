<Window x:Class="CinemaTicketBookingSystem.Views.AdminMovieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaTicketBookingSystem.Views"
        mc:Ignorable="d"
        Title="KPID CINEMA - Quản Lý Phim &amp; Thể Loại" 
        Height="840" Width="1350"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="#F3F4F6"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Palette Tokens -->
        <SolidColorBrush x:Key="BgDark" Color="#070A12"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#0D1220"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131B2E"/>
        <SolidColorBrush x:Key="BorderQuiet" Color="#1E2B47"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A3B60"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E50914"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#F41824"/>
        <SolidColorBrush x:Key="AccentGold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C00711"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Tab Button Style -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Tab Button Style -->
        <Style x:Key="ActiveNavBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="Background" Value="#251214"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#161922"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#161922"/>
            <Setter Property="AlternatingRowBackground" Value="#1A1E29"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111319"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A1B20"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EllipsisTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <!-- Galaxy Cosmic Background Layer -->
        <Image Source="/Assets/galaxy_bg.jpg" Stretch="UniformToFill" Opacity="0.14" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Global Admin Navigation Header -->
                <RowDefinition Height="*"/>    <!-- Module Content (TabControl) -->
            </Grid.RowDefinitions>

        <!-- 1. TOP GLOBAL ADMIN HEADER -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand -->
                    <ColumnDefinition Width="*"/>    <!-- Center Navigation Links -->
                    <ColumnDefinition Width="Auto"/> <!-- Current User & Exit -->
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#111319" Margin="0,0,10,0" BorderBrush="#2E4069" BorderThickness="1.5">
                        <Image Source="/Assets/logo.png" Stretch="Uniform" Margin="3"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KPID" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="{StaticResource AccentRed}" Margin="0,0,5,0"/>
                            <TextBlock Text="CINEMA" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="HỆ THỐNG QUẢN TRỊ" FontSize="10" Foreground="{StaticResource AccentGold}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Links -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="🎬 Phim &amp; Thể loại" Style="{StaticResource ActiveNavBtnStyle}" Margin="4,0"/>
                    <Button Content="🏛️ Phòng &amp; Suất chiếu" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToShowtimes_Click"/>
                    <Button Content="🍿 Bắp nước" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToFood_Click"/>
                    <Button Content="📊 Soát vé &amp; Thống kê" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToReports_Click"/>
                </StackPanel>

                <!-- Current User & Exit -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="txtAdminName" Text="Admin: Quản trị viên" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Text="Phân quyền: Toàn quyền quản trị" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Về Trang Khách" Style="{StaticResource GhostBtnStyle}" Margin="0,0,8,0" Click="BtnCustomerHome_Click"/>
                    <Button Content="Đăng xuất" Style="{StaticResource GhostBtnStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="20,14">
            <!-- TAB 1: QUẢN LÝ PHIM -->
            <TabItem Header="🎬 DANH SÁCH &amp; QUẢN LÝ PHIM">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Left: DataGrid & Filters -->
                        <ColumnDefinition Width="20"/>  <!-- Gap -->
                        <ColumnDefinition Width="440"/> <!-- Right: Edit Form & Poster -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: FILTER BAR & DATAGRID -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Search & Filter Bar -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                                <RowDefinition Height="Auto"/> <!-- Table Stats -->
                            </Grid.RowDefinitions>

                            <!-- Filters -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>    <!-- Search Box -->
                                    <ColumnDefinition Width="180"/>  <!-- Genre Filter -->
                                    <ColumnDefinition Width="185"/>  <!-- Status Filter -->
                                    <ColumnDefinition Width="Auto"/> <!-- Refresh Button -->
                                </Grid.ColumnDefinitions>

                                <!-- Search by Title -->
                                <Border Grid.Column="0" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,10,0">
                                    <Grid Margin="12,0">
                                        <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtSearchTitle" Margin="24,0,0,0" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" FontSize="13" TextChanged="TxtSearchTitle_TextChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Genre Filter -->
                                <ComboBox x:Name="cbFilterGenre" Grid.Column="1" Height="38" Margin="0,0,10,0" SelectionChanged="Filter_SelectionChanged"/>

                                <!-- Status Filter -->
                                <ComboBox x:Name="cbFilterStatus" Grid.Column="2" Height="38" Margin="0,0,10,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="-- Tất cả trạng thái --" IsSelected="True"/>
                                    <ComboBoxItem Content="Đang chiếu"/>
                                    <ComboBoxItem Content="Ngừng chiếu"/>
                                </ComboBox>

                                <!-- Reset Button -->
                                <Button Grid.Column="3" Content="🔄 Đặt lại" Style="{StaticResource GhostBtnStyle}" Height="38" Click="BtnResetFilter_Click"/>
                            </Grid>

                            <!-- DataGrid -->
                            <DataGrid x:Name="dgMovies" Grid.Row="1" SelectionChanged="DgMovies_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding MovieId}" Width="55" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                    <DataGridTextColumn Header="TÊN PHIM" Binding="{Binding Title}" Width="2.4*" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                    <DataGridTextColumn Header="THỂ LOẠI" Binding="{Binding GenreName}" Width="120" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                    <DataGridTextColumn Header="THỜI LƯỢNG" Binding="{Binding DurationString}" Width="110" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                    <DataGridTextColumn Header="NGÀY PHÁT HÀNH" Binding="{Binding ReleaseDateString}" Width="145" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                    <DataGridTextColumn Header="ĐỘ TUỔI" Binding="{Binding AgeRating}" Width="85" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBg}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Table Stats -->
                            <TextBlock x:Name="txtMovieCount" Grid.Row="2" Text="Tổng cộng: 0 phim" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>

                    <!-- RIGHT: MOVIE DETAIL & CRUD FORM -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN PHIM" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                                <!-- Title -->
                                <TextBlock Text="TÊN PHIM *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,0,12">
                                    <TextBox x:Name="txtTitle" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                                </Border>

                                <!-- Genre & Age Rating Grid -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Genre -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="THỂ LOẠI *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="cbGenre" Height="38"/>
                                    </StackPanel>

                                    <!-- Age Rating -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ĐỘ TUỔI *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="cbAgeRating" Height="38">
                                            <ComboBoxItem Content="P (Mọi lứa tuổi)"/>
                                            <ComboBoxItem Content="T13 (Trên 13 tuổi)"/>
                                            <ComboBoxItem Content="T16 (Trên 16 tuổi)"/>
                                            <ComboBoxItem Content="T18 (Trên 18 tuổi)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Duration & Release Date Grid -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Duration -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="THỜI LƯỢNG (PHÚT) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="38">
                                            <TextBox x:Name="txtDuration" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Release Date -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="NGÀY KHỞI CHIẾU *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <DatePicker x:Name="dpReleaseDate" Height="38"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Status CheckBox -->
                                <CheckBox x:Name="chkStatus" Content="Đang chiếu tại rạp (Kích hoạt)" Foreground="White" FontSize="13" IsChecked="True" Margin="0,0,0,12"/>

                                <!-- Poster Preview & Selector -->
                                <TextBlock Text="POSTER PHIM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="106"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="96" Height="136" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True">
                                        <Image x:Name="imgFormPoster" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="txtPosterPath" Text="Chưa chọn poster" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                        <Button Content="📁 Chọn ảnh Poster..." Style="{StaticResource GhostBtnStyle}" Height="36" Click="BtnBrowsePoster_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Description -->
                                <TextBlock Text="MÔ TẢ NỘI DUNG PHIM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="70" Margin="0,0,0,16">
                                    <TextBox x:Name="txtDescription" Background="Transparent" BorderThickness="0" Foreground="White" Margin="10,6" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </Border>

                                <!-- Action Buttons -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnAddMovie" Grid.Column="0" Content="＋ Thêm Phim Mới" Style="{StaticResource PrimaryBtnStyle}" Height="40" Click="BtnAddMovie_Click"/>
                                    <Button x:Name="btnUpdateMovie" Grid.Column="2" Content="💾 Lưu Cập Nhật" Style="{StaticResource GhostBtnStyle}" Height="40" Click="BtnUpdateMovie_Click"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnToggleStatusMovie" Grid.Column="0" Content="🛑 Đổi Trạng Thái" Style="{StaticResource GhostBtnStyle}" Height="36" Click="BtnToggleStatusMovie_Click"/>
                                    <Button x:Name="btnClearForm" Grid.Column="2" Content="🧹 Làm Mới Form" Style="{StaticResource GhostBtnStyle}" Height="36" Click="BtnClearForm_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: QUẢN LÝ THỂ LOẠI -->
            <TabItem Header="🏷️ QUẢN LÝ THỂ LOẠI (GENRE)">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Left: DataGrid -->
                        <ColumnDefinition Width="20"/>  <!-- Gap -->
                        <ColumnDefinition Width="420"/> <!-- Right: CRUD Form -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Genre Table -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="DANH SÁCH THỂ LOẠI PHIM" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                            <DataGrid x:Name="dgGenres" Grid.Row="1" SelectionChanged="DgGenres_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ THỂ LOẠI" Binding="{Binding GenreId}" Width="120" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                    <DataGridTextColumn Header="TÊN THỂ LOẠI" Binding="{Binding GenreName}" Width="2*" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                    <DataGridTextColumn Header="SỐ LƯỢNG PHIM" Binding="{Binding MovieCount}" Width="140" ElementStyle="{StaticResource EllipsisTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right: Genre Form -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="THÊM / SỬA THỂ LOẠI" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                            <TextBlock Text="TÊN THỂ LOẠI *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,16">
                                <TextBox x:Name="txtGenreName" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="＋ Thêm Thể Loại" Style="{StaticResource PrimaryBtnStyle}" Height="40" Click="BtnAddGenre_Click"/>
                                <Button Grid.Column="2" Content="💾 Lưu Sửa Tên" Style="{StaticResource GhostBtnStyle}" Height="40" Click="BtnUpdateGenre_Click"/>
                            </Grid>
                            <Button Content="🧹 Làm Mới" Style="{StaticResource GhostBtnStyle}" Height="36" Click="BtnClearGenreForm_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</Window>
