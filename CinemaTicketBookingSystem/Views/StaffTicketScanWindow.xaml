<Window x:Class="CinemaTicketBookingSystem.Views.StaffTicketScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaTicketBookingSystem.Views"
        mc:Ignorable="d"
        Title="KPID CINEMA - Cổng Soát Vé Rạp (Ticket Inspector Portal)" 
        Height="800" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="#F3F4F6"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Palette Tokens -->
        <SolidColorBrush x:Key="BgDark" Color="#070A12"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#0D1220"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131B2E"/>
        <SolidColorBrush x:Key="BorderQuiet" Color="#1E2B47"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A3B60"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E50914"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#F41824"/>
        <SolidColorBrush x:Key="AccentGold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C00711"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#161922"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#161922"/>
            <Setter Property="AlternatingRowBackground" Value="#1A1E29"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111319"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <!-- Galaxy Background Layer -->
        <Image Source="/Assets/galaxy_bg.jpg" Stretch="UniformToFill" Opacity="0.14" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Check-in Workspace -->
            </Grid.RowDefinitions>

        <!-- 1. TOP HEADER (STAFF PORTAL) -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand -->
                    <ColumnDefinition Width="*"/>    <!-- Title Badge -->
                    <ColumnDefinition Width="Auto"/> <!-- User Info & Logout -->
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#111319" Margin="0,0,10,0" BorderBrush="#2E4069" BorderThickness="1.5">
                        <Image Source="/Assets/logo.png" Stretch="Uniform" Margin="3"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KPID" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="{StaticResource AccentRed}" Margin="0,0,5,0"/>
                            <TextBlock Text="CINEMA" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="CỔNG SOÁT VÉ RẠP PHIM" FontSize="10" Foreground="{StaticResource AccentGold}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Portal Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1C202C" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="20" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎟️ CA TRỰC SOÁT VÉ CỬA RẠP" FontSize="12" FontWeight="Bold" Foreground="#86EFAC"/>
                            <TextBlock Text=" • Sẵn sàng quét mã QR" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Current User & Exit -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="txtStaffName" Text="Nhân viên: Nguyễn Văn Soát Vé" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Text="Vai trò: Nhân viên soát vé (Staff)" FontSize="11" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="🚪 Đăng xuất" Style="{StaticResource GhostBtnStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN WORKSPACE -->
        <Grid Grid.Row="1" Margin="24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/> <!-- Left: Scan Input & Quick Select -->
                <ColumnDefinition Width="20"/>  <!-- Gap -->
                <ColumnDefinition Width="*"/>    <!-- Right: Ticket Verification Card -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: INPUT & QUICK ACCESS -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- QR Input Box -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                        <RowDefinition Height="*"/>    <!-- Quick recent tickets -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="QUÉT MÃ VÉ ĐIỆN TỬ (QR CODE)" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                    <!-- QR Code Input -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="NHẬP HOẶC DÙNG MÁY QUÉT BARCODE/QR *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource AccentRed}" BorderThickness="1.5" CornerRadius="8" Height="46">
                            <Grid Margin="12,0">
                                <TextBlock Text="📷" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtCheckInCode" Margin="26,0,0,0" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" KeyDown="TxtCheckInCode_KeyDown"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="💡 Bạn có thể bấm phím Enter sau khi nhập để kiểm tra vé tức thì." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid Grid.Row="2" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔍 KIỂM TRA VÉ" Style="{StaticResource PrimaryBtnStyle}" Height="42" Click="BtnCheckTicket_Click"/>
                        <Button Grid.Column="2" Content="🧹 Xóa" Style="{StaticResource GhostBtnStyle}" Height="42" Padding="14,0" Click="BtnClearCode_Click"/>
                    </Grid>

                    <!-- Quick recent tickets -->
                    <Border Grid.Row="3" Background="#111319" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="VÉ ĐẶT GẦN ĐÂY (TEST NHANH):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="spRecentTickets">
                                    <TextBlock Text="Đang tải danh sách vé..." FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: TICKET RESULT & CONFIRMATION -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <!-- EMPTY STATE -->
                    <StackPanel x:Name="pnlNoTicket" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎟️" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="SẴN SÀNG SOÁT VÉ VÀO RẠP" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Quét mã QR trên vé điện tử của khách hàng hoặc nhập mã để tiến hành soát vé." FontSize="13" Foreground="{StaticResource TextMuted}" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- RESULT STATE -->
                    <Grid x:Name="pnlTicketResult" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Status Banner -->
                            <RowDefinition Height="*"/>    <!-- Ticket Detail Card -->
                            <RowDefinition Height="Auto"/> <!-- Check-in Button -->
                        </Grid.RowDefinitions>

                        <!-- Status Banner -->
                        <Border x:Name="bdrCheckInBanner" Grid.Row="0" Background="#14532D" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtCheckInIcon" Grid.Column="0" Text="✅" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtCheckInTitle" Text="VÉ HỢP LỆ - CHƯA SỬ DỤNG" FontSize="15" FontWeight="Black" Foreground="#86EFAC"/>
                                    <TextBlock x:Name="txtCheckInSub" Text="Khách hàng hợp lệ. Vui lòng bấm 'Xác nhận soát vé' để cho khách vào rạp." FontSize="12" Foreground="#A7F3D0" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Ticket Detail Card -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Movie Title -->
                                    <TextBlock x:Name="txtResultMovie" Text="TÊN BỘ PHIM" FontSize="20" FontWeight="Black" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Mã định danh vé:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="txtResultCode" Text="KPID-ABC12345" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Khách hàng đặt vé:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="txtResultCustomer" Text="Nguyễn Văn A (0988888888)" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Separator Background="{StaticResource BorderQuiet}" Margin="0,10"/>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Phòng chiếu:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="txtResultRoom" Text="Phòng 01 (Standard)" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Suất chiếu:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="txtResultShowtime" Text="18:00 • 28/10/2026" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Ghế xem phim:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="txtResultSeats" Text="A1, A2, A3" FontSize="15" FontWeight="Black" Foreground="#86EFAC" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Bắp nước kèm theo:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="txtResultFoods" Text="Combo Solo (x1)" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Separator Background="{StaticResource BorderQuiet}" Margin="0,10"/>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Tổng tiền đơn vé:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="txtResultAmount" Text="150,000 đ" FontSize="16" FontWeight="Black" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Hình thức thanh toán:" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Border x:Name="bdrPaymentMethodBadge" Background="#1E3A8A" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                                            <TextBlock x:Name="txtResultPaymentMethod" Text="💳 VNPAY (Đã thanh toán)" FontSize="12" FontWeight="Bold" Foreground="#93C5FD"/>
                                        </Border>
                                    </Grid>

                                    <!-- Alert box when Cash payment -->
                                    <Border x:Name="bdrCashAlert" Background="#2B1A09" BorderBrush="{StaticResource AccentGold}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="💵" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="ĐƠN VÉ THANH TOÁN TẠI QUẦY (TIỀN MẶT)" FontSize="12" FontWeight="Black" Foreground="{StaticResource AccentGold}"/>
                                                <TextBlock x:Name="txtCashAlertDetail" Text="Nhân viên vui lòng thu đúng số tiền trước khi xác nhận soát vé!" FontSize="11" Foreground="#FDE68A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Action Button -->
                        <Button x:Name="btnConfirmCheckIn" Grid.Row="2" Content="✔ XÁC NHẬN SOÁT VÉ VÀO PHÒNG CHIẾU" Style="{StaticResource PrimaryBtnStyle}" Height="48" FontSize="14" Click="BtnConfirmCheckIn_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>

