<Window x:Class="CinemaTicketBookingSystem.Views.AdminShowtimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaTicketBookingSystem.Views"
        mc:Ignorable="d"
        Title="KPID CINEMA - Quản Lý Suất Chiếu &amp; Phòng Chiếu" 
        Height="840" Width="1350"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="#F3F4F6"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Palette Tokens -->
        <SolidColorBrush x:Key="BgDark" Color="#070A12"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#0D1220"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131B2E"/>
        <SolidColorBrush x:Key="BorderQuiet" Color="#1E2B47"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A3B60"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E50914"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#F41824"/>
        <SolidColorBrush x:Key="AccentGold" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C00711"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Tab Button Style -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Tab Button Style -->
        <Style x:Key="ActiveNavBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="Background" Value="#251214"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#161922"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#161922"/>
            <Setter Property="AlternatingRowBackground" Value="#1A1E29"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderQuiet}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111319"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderQuiet}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A1B20"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <!-- Galaxy Cosmic Background Layer -->
        <Image Source="/Assets/galaxy_bg.jpg" Stretch="UniformToFill" Opacity="0.14" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Global Admin Header -->
                <RowDefinition Height="*"/>    <!-- Module Content Tabs -->
            </Grid.RowDefinitions>

        <!-- 1. TOP GLOBAL ADMIN HEADER -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#111319" Margin="0,0,10,0" BorderBrush="#2E4069" BorderThickness="1.5">
                        <Image Source="/Assets/logo.png" Stretch="Uniform" Margin="3"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KPID" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="{StaticResource AccentRed}" Margin="0,0,5,0"/>
                            <TextBlock Text="CINEMA" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="24" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="HỆ THỐNG QUẢN TRỊ" FontSize="10" Foreground="{StaticResource AccentGold}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Links -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="🎬 Phim &amp; Thể loại" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToMovies_Click"/>
                    <Button Content="🏛️ Phòng &amp; Suất chiếu" Style="{StaticResource ActiveNavBtnStyle}" Margin="4,0"/>
                    <Button Content="🍿 Bắp nước" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToFood_Click"/>
                    <Button Content="📊 Soát vé &amp; Thống kê" Style="{StaticResource NavBtnStyle}" Margin="4,0" Click="NavToReports_Click"/>
                </StackPanel>

                <!-- Current User & Exit -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="txtAdminName" Text="Admin: Quản trị viên" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Text="Phân quyền: Toàn quyền quản trị" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Về Trang Khách" Style="{StaticResource GhostBtnStyle}" Margin="0,0,8,0" Click="BtnCustomerHome_Click"/>
                    <Button Content="Đăng xuất" Style="{StaticResource GhostBtnStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="20,14">
            <!-- TAB 1: QUẢN LÝ SUẤT CHIẾU -->
            <TabItem Header="  🏛️ QUẢN LÝ SUẤT CHIẾU (SHOWTIME)  " FontSize="13" FontWeight="Bold">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Left: DataGrid & Filters -->
                        <ColumnDefinition Width="20"/>  <!-- Gap -->
                        <ColumnDefinition Width="440"/> <!-- Right: CRUD Form & Anti-conflict -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Filters & Showtime Table -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Filters -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                                <RowDefinition Height="Auto"/> <!-- Stats -->
                            </Grid.RowDefinitions>

                            <!-- Filters -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>  <!-- Date Filter -->
                                    <ColumnDefinition Width="170"/>  <!-- Room Filter -->
                                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                    <ColumnDefinition Width="Auto"/> <!-- Reset Button -->
                                </Grid.ColumnDefinitions>

                                <!-- Date Filter -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="LỌC THEO NGÀY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="dpFilterDate" Height="36" SelectedDateChanged="FilterShowtime_Changed"/>
                                </StackPanel>

                                <!-- Room Filter -->
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="LỌC THEO PHÒNG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbFilterRoom" Height="36" SelectionChanged="FilterShowtime_Changed"/>
                                </StackPanel>

                                <!-- Reset Button -->
                                <Button Grid.Column="3" Content="🔄 Xem tất cả" Style="{StaticResource GhostBtnStyle}" Height="36" VerticalAlignment="Bottom" Click="BtnResetShowtimeFilter_Click"/>
                            </Grid>

                            <!-- DataGrid -->
                            <DataGrid x:Name="dgShowtimes" Grid.Row="1" SelectionChanged="DgShowtimes_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ShowtimeId}" Width="50"/>
                                    <DataGridTextColumn Header="TÊN PHIM" Binding="{Binding MovieTitle}" Width="2*"/>
                                    <DataGridTextColumn Header="PHÒNG CHIẾU" Binding="{Binding RoomName}" Width="120"/>
                                    <DataGridTextColumn Header="BẮT ĐẦU" Binding="{Binding StartTimeString}" Width="140"/>
                                    <DataGridTextColumn Header="KẾT THÚC" Binding="{Binding EndTimeString}" Width="140"/>
                                    <DataGridTextColumn Header="GIÁ CƠ BẢN" Binding="{Binding BasePriceString}" Width="110"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Stats -->
                            <TextBlock x:Name="txtShowtimeCount" Grid.Row="2" Text="Tổng cộng: 0 suất chiếu" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Right: CRUD Form -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THIẾT LẬP SUẤT CHIẾU MỚI / SỬA" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                                <!-- Movie Select -->
                                <TextBlock Text="CHỌN PHIM CHIẾU *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cbMovie" Height="38" Margin="0,0,0,12" SelectionChanged="CbMovieOrTime_Changed"/>

                                <!-- Room Select -->
                                <TextBlock Text="CHỌN PHÒNG CHIẾU *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cbRoom" Height="38" Margin="0,0,0,12"/>

                                <!-- Start Date & Time Grid -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Date -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="NGÀY CHIẾU *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <DatePicker x:Name="dpShowDate" Height="38" SelectedDateChanged="CbMovieOrTime_Changed"/>
                                    </StackPanel>

                                    <!-- Hour -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="GIỜ BẮT ĐẦU *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="cbHour" Height="38" SelectionChanged="CbMovieOrTime_Changed"/>
                                    </StackPanel>

                                    <!-- Minute -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PHÚT *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="cbMinute" Height="38" SelectionChanged="CbMovieOrTime_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Auto-calculated End Time Pill -->
                                <Border Background="#1C202C" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="TỰ ĐỘNG TÍNH GIỜ KẾT THÚC (DỰA VÀO THỜI LƯỢNG + 15P DỌN PHÒNG)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGold}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="txtCalculatedEndTime" Text="Giờ kết thúc: Chưa chọn" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Base Price -->
                                <TextBlock Text="GIÁ VÉ GỐC (VND - TỐI ĐA 200.000 Đ) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,0,6">
                                    <TextBox x:Name="txtBasePrice" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                                </Border>

                                <!-- Golden Hour / Weekend auto suggestion hint -->
                                <TextBlock x:Name="txtPriceSuggestionHint" Text="💡 Gợi ý: Khung giờ vàng (18h-22h) hoặc cuối tuần đã được áp dụng +20% giá vé." FontSize="11" Foreground="{StaticResource AccentGold}" Margin="0,0,0,14" TextWrapping="Wrap" Visibility="Collapsed"/>

                                <!-- Status CheckBox -->
                                <CheckBox x:Name="chkShowtimeStatus" Content="Đang mở bán vé (Kích hoạt)" Foreground="White" FontSize="13" IsChecked="True" Margin="0,0,0,18"/>

                                <!-- Action Buttons -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="＋ Thêm Suất Chiếu" Style="{StaticResource PrimaryBtnStyle}" Height="40" Click="BtnAddShowtime_Click"/>
                                    <Button Grid.Column="2" Content="💾 Lưu Cập Nhật" Style="{StaticResource GhostBtnStyle}" Height="40" Click="BtnUpdateShowtime_Click"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="🛑 Hủy Suất Chiếu" Style="{StaticResource GhostBtnStyle}" Height="36" Click="BtnToggleStatusShowtime_Click"/>
                                    <Button Grid.Column="2" Content="🧹 Làm Mới Form" Style="{StaticResource GhostBtnStyle}" Height="36" Click="BtnClearShowtimeForm_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: QUẢN LÝ PHÒNG CHIẾU -->
            <TabItem Header="  🏢 QUẢN LÝ PHÒNG CHIẾU (ROOM)  " FontSize="13" FontWeight="Bold">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Left: DataGrid -->
                        <ColumnDefinition Width="20"/>  <!-- Gap -->
                        <ColumnDefinition Width="420"/> <!-- Right: CRUD Form -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Room Table -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="DANH SÁCH PHÒNG CHIẾU RẠP" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                            <DataGrid x:Name="dgRooms" Grid.Row="1" SelectionChanged="DgRooms_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ PHÒNG" Binding="{Binding RoomId}" Width="90"/>
                                    <DataGridTextColumn Header="TÊN PHÒNG CHIẾU" Binding="{Binding RoomName}" Width="2*"/>
                                    <DataGridTextColumn Header="TỔNG SỐ GHẾ" Binding="{Binding TotalSeats}" Width="120"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right: Room Form -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="12" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="THÊM / SỬA PHÒNG CHIẾU" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                            <!-- Room Name -->
                            <TextBlock Text="TÊN PHÒNG CHIẾU *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,12">
                                <TextBox x:Name="txtRoomName" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                            </Border>

                            <!-- Total Seats (Default 40) -->
                            <TextBlock Text="TỔNG SỐ GHẾ (MẶC ĐỊNH 40 - LƯỚI 5x8) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderQuiet}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,12">
                                <TextBox x:Name="txtTotalSeats" Text="40" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                            </Border>

                            <!-- Room Status -->
                            <CheckBox x:Name="chkRoomStatus" Content="Đang hoạt động (Kích hoạt)" Foreground="White" FontSize="13" IsChecked="True" Margin="0,0,0,18"/>

                            <!-- Action Buttons -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="＋ Thêm Phòng" Style="{StaticResource PrimaryBtnStyle}" Height="40" Click="BtnAddRoom_Click"/>
                                <Button Grid.Column="2" Content="💾 Lưu Sửa" Style="{StaticResource GhostBtnStyle}" Height="40" Click="BtnUpdateRoom_Click"/>
                            </Grid>
                            <Button Content="🧹 Làm Mới Form" Style="{StaticResource GhostBtnStyle}" Height="36" Click="BtnClearRoomForm_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</Window>
