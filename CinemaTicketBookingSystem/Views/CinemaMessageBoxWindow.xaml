<Window x:Class="CinemaTicketBookingSystem.Views.CinemaMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Primary Action Button Style -->
        <Style x:Key="DialogPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#E50914"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F41824"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C00711"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost / Secondary Button Style -->
        <Style x:Key="DialogGhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C202C"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3B60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252D3F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" CornerRadius="12" BorderThickness="1" BorderBrush="#25324E" x:Name="bdrMain">
        <!-- Natural soft black drop shadow effect (no neon glare) -->
        <Border.Effect>
            <DropShadowEffect x:Name="shadowEffect" BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#141B2D" Offset="0.0"/>
                <GradientStop Color="#0B0F19" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar / Drag Header -->
                <RowDefinition Height="*"/>    <!-- Content & Icon -->
                <RowDefinition Height="Auto"/> <!-- Buttons Row -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0" Background="#0D1220" BorderBrush="#1E2B47" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="18,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#111319" Margin="0,0,10,0" BorderBrush="#2E4069" BorderThickness="1">
                            <Image Source="/Assets/logo.png" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="KPID" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="17" Foreground="{StaticResource AccentRed}" Margin="0,0,4,0"/>
                            <TextBlock Text="CINEMA" FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="17" Foreground="White" Margin="0,0,12,0"/>
                        </StackPanel>
                        <!-- Badge for Notice Type -->
                        <Border x:Name="bdrTypeBadge" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTypeBadge" Text="QUY ĐỊNH RẠP" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Close Button '✕' -->
                    <Button Grid.Column="2" x:Name="btnCloseX" Content="✕" Width="26" Height="26" Style="{StaticResource DialogGhostBtnStyle}" Padding="0" Click="BtnCloseX_Click"/>
                </Grid>
            </Border>

            <!-- 2. Message Content Area -->
            <Grid Grid.Row="1" Margin="22,14,22,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" x:Name="bdrIconCircle" Width="46" Height="46" CornerRadius="23" VerticalAlignment="Top" Margin="0,2,16,0">
                    <TextBlock x:Name="txtIcon" Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Caption & Message Body -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtCaption" Text="Quy định chọn ghế rạp chiếu phim" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtMessage" Text="Nội dung thông báo..." FontSize="13" Foreground="#E2E8F0" LineHeight="19" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- 3. Action Buttons Area -->
            <Border Grid.Row="2" Background="#0A0E17" BorderBrush="#1E2B47" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="18,10">
                <StackPanel x:Name="spButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Buttons are added dynamically based on MessageBoxButton -->
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

